--- !u!114 &7822589901947738415
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5576175128954152328}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e240c06d55e336e4992e5ea3b7b63abf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  Dialogue:
    DialogueLines:
    - 'Nurse: I''m sorry, But they passed away this morning, We don''t allow civilians
      to see bodies for sanitary reasons'
    - 'You: To hell with the sanitary reasons! I want to talk to my friend!'
    - 'Nurse: Again I''d like to state that they were pronounced dead at 6:34 AM
      today. I''m sorry for your loss.'
    - 'You: Why couldn''t you save them?! isn''t that your damn job?!

'
    - 'Nurse: Their situation had reached to a level where we didn''t have the funds
      to go through with it

'
    - 'You: Funds? Money? is that what this is about? It''s always about money with
      you people

'
    - 'Nurse: Please remain calm before I have to-

'
    - 'You: Money is what you want, right? I''ll get you your damn money. and you
      better save them

'
    - 'Nurse: But they''re already-

'
    - 'You: Shut up, just shut up, I''ll be back with your stupid green paper bills.
      and they better be alive.

'
    - 'Nurse: ...'
    - End Conversation
